package web

templ IndexPage() {
    <main class="max-w-6xl mx-auto px-4 py-10">
        <section id="collection" class="glass-panel hero-panel p-6 sm:p-8">
            <div
                class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-6 text-center sm:text-left"
            >
                <div class="space-y-1">
                    <p
                        class="uppercase tracking-[0.4em] text-xs text-[var(--gold-soft)]"
                    >
                        House of scent
                    </p>
                    <h1
                        class="text-3xl sm:text-4xl font-semibold font-display text-white"
                    >
                        Bliss Atelier Perfumes
                    </h1>
                    <p class="text-gray-400 text-sm mt-1">
                        Choose a scent. Become a different person.
                    </p>
                </div>
                <div class="text-sm text-gray-300 text-center sm:text-right">
                    Showing <span id="resultsCount">0</span>
                </div>
            </div>
            <section
                id="productGrid"
                class="product-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
            ></section>
        </section>
    </main>
    <script src="/static/app.js"></script>
}
