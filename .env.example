# Optional Compose settings only; credentials are generated under ignored .local/.
COMPOSE_PROJECT_NAME=bliss
BLISS_HTTP_PORT=8080
BLISS_SECRET_DIR=./.local/dev

# Google OpenID Connect (OIDC) & Initial Owner Bootstrap
# Configure in .env to test live Google authentication
GO_GOOGLE_CLIENT_ID=
GO_GOOGLE_CLIENT_SECRET=
GO_GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
GO_BOOTSTRAP_OWNER_EMAIL=
