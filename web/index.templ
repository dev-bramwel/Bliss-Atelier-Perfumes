package web

import (
	"fmt"
	"github.com/dev-bramwel/Bliss-Atelier-Perfumes/internal/catalog"
)

templ IndexPage(products []catalog.Product) {
	{{ heroImage := "" }}
	{{ heroName := "Bliss Atelier Perfumes" }}
	if len(products) > 0 {
		{{ heroName = products[0].Name }}
		if len(products[0].Images) > 0 {
			{{ heroImage = products[0].Images[0] }}
		}
	}
	<main class="storefront-main">
		<section class="editorial-hero" aria-labelledby="homeTitle">
			<div class="editorial-hero-copy">
				<p class="editorial-eyebrow">Bliss Atelier · As you wish</p>
				<h1 id="homeTitle">Find the scent that feels like you.</h1>
				<p class="editorial-intro">A considered collection for every mood and moment.</p>
				<a class="editorial-cta" href="#collection">Explore fragrances <span aria-hidden="true">→</span></a>
			</div>
			<div class="editorial-hero-image">
				if heroImage != "" {
					<img src={ heroImage } alt={ "Featured fragrance: " + heroName } fetchpriority="high" />
				} else {
					<div class="editorial-hero-placeholder" aria-hidden="true">BP</div>
				}
			</div>
		</section>
		<section id="collection" class="collection-section" aria-labelledby="collectionTitle">
			<div class="collection-heading">
				<div>
					<p class="collection-eyebrow">Find your next signature</p>
					<h2 id="collectionTitle">The collection</h2>
				</div>
				<p class="collection-count" aria-live="polite">Showing <span id="resultsCount">{ fmt.Sprintf("%d", len(products)) }</span> fragrances</p>
			</div>
			<div class="collection-filters" role="search" aria-label="Search and filter fragrances">
				<label class="collection-search">
					<span class="sr-only">Search fragrances, notes, or moods</span>
					<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 4.2 4.2"></path></svg>
					<input id="searchInput" type="search" placeholder="Search fragrances, notes, or moods" />
				</label>
				<label class="sr-only" for="genderSelect">Filter by fragrance gender</label>
				<select id="genderSelect" aria-label="Filter by gender"><option value="all">All genders</option></select>
				<label class="sr-only" for="categorySelect">Filter by fragrance category</label>
				<select id="categorySelect" aria-label="Filter by category"><option value="all">All categories</option></select>
			</div>
			<section
				id="productGrid"
				class="product-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
				aria-label="Fragrances"
			>
				for _, p := range products {
					@ProductCard(p)
				}
			</section>
		</section>
	</main>
	@ProductModal()
}

templ ProductCard(p catalog.Product) {
	{{ thumb := "" }}
	if len(p.Images) > 0 {
		{{ thumb = p.Images[0] }}
	}
	{{ gender := p.Gender }}
	if gender == "" {
		{{ gender = "Unisex" }}
	}
	<div class="collection-card flex flex-col">
		<button type="button" class="product-card-img" data-open-product={ p.ID } aria-label={ "View details for " + p.Name }>
			<img
				src={ thumb }
				alt=""
				onerror="this.onerror=null;this.classList.add('img-broken')"
				loading="lazy"
			/>
			<div class="product-card-img-placeholder">
				<span>
					if len(p.Name) > 0 {
						{ string([]rune(p.Name)[0:1]) }
					}
				</span>
			</div>
			<div class="product-card-img-overlay">
				<span class="product-card-view-btn">View Details</span>
			</div>
		</button>
		<div class="collection-card-content flex flex-col flex-1">
			<div class="flex items-start justify-between gap-3">
				<div>
					<div class="collection-card-category">
						{ gender } &bull; { p.Category }
					</div>
					<h3 class="collection-card-name">{ p.Name }</h3>
					<p class="collection-card-notes">{ p.Size } &bull; { p.Notes }</p>
					<p class="stock-badge">
						if !p.Available {
							if p.Stock == 0 {
								Sold Out
							} else {
								Currently unavailable
							}
						} else if p.Stock <= 5 {
							{ fmt.Sprintf("Only %d left in stock", p.Stock) }
						} else {
							In Stock
						}
					</p>
				</div>
				<div class="collection-card-price-wrap">
					<div class="collection-card-price">
						KES { formatPriceKes(p.PriceKes) }
					</div>
				</div>
			</div>
			<div class="collection-card-actions">
				if p.Available {
					<button class="collection-add gold-btn" data-add={ p.ID }>
						Add to cart
					</button>
				} else {
					<button class="collection-add gold-btn" data-add={ p.ID } disabled>
						Currently unavailable
					</button>
				}
				<a
					class="collection-whatsapp"
					href={ templ.SafeURL(whatsAppOrderURL(p)) }
					target="_blank"
					rel="noreferrer"
				>
					WhatsApp
				</a>
			</div>
		</div>
	</div>
}

templ ProductModal() {
	<div id="productModal" class="product-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modalName">
		<div class="product-modal-panel">
			<button type="button" class="product-modal-close" id="modalClose" aria-label="Close product details">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
					<path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L10.94 12l-6.72 6.72a.75.75 0 1 0 1.06 1.06L12 13.06l6.72 6.72a.75.75 0 1 0 1.06-1.06L13.06 12l6.72-6.72a.75.75 0 0 0-1.06-1.06L12 10.94 5.28 4.22Z"></path>
				</svg>
			</button>
			<div class="product-modal-inner">
				<div class="product-modal-images">
					<div class="product-modal-main-img-wrap" id="modalImgWrap">
						<img id="modalMainImg" src="" alt="" class="product-modal-main-img"/>
						<div class="product-modal-img-placeholder"><span id="modalImgInitial"></span></div>
						<button class="modal-nav-btn modal-nav-prev" id="modalPrev" aria-label="Previous image">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M14.47 5.47a.75.75 0 0 1 0 1.06L8.81 12l5.66 5.47a.75.75 0 1 1-1.04 1.08l-6.25-6a.75.75 0 0 1 0-1.08l6.25-6a.75.75 0 0 1 1.04.02Z"></path></svg>
						</button>
						<button class="modal-nav-btn modal-nav-next" id="modalNext" aria-label="Next image">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M9.53 5.47a.75.75 0 0 0 0 1.06L15.19 12l-5.66 5.47a.75.75 0 1 0 1.04 1.08l6.25-6a.75.75 0 0 0 0-1.08l-6.25-6a.75.75 0 0 0-1.04.02Z"></path></svg>
						</button>
					</div>
					<div id="modalThumbs" class="product-modal-thumbs"></div>
				</div>
				<div class="product-modal-details">
					<div class="product-modal-badge" id="modalBadge"></div>
					<h2 class="product-modal-name" id="modalName"></h2>
					<div class="product-modal-price" id="modalPrice"></div>
					<div class="product-modal-meta" id="modalMeta"></div>
					<p class="product-modal-description" id="modalDescription"></p>
					<div class="product-modal-actions">
						<button id="modalAddToCart" class="gold-btn py-3 rounded-[10px] font-semibold text-sm w-full">Add to Cart</button>
						<a id="modalWhatsApp" href="#" target="_blank" rel="noreferrer" class="gold-outline-btn py-3 rounded-[10px] text-sm font-semibold text-center w-full block">WhatsApp Order</a>
					</div>
				</div>
			</div>
		</div>
	</div>
}
