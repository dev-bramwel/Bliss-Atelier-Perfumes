package web

import "github.com/dev-bramwel/Bliss-Atelier-Perfumes/internal/catalog"

templ Layout(title string, pageScript string, products []catalog.Product, children ...templ.Component) {
    <!doctype html>
    <html lang="en">
        <head>
            <meta charset="UTF-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <meta name="api-base-url" content="" />
            <title>{title} — Bliss Atelier Perfumes</title>
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
            <link
                href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
                rel="stylesheet"
            />
            <link rel="stylesheet" href="/static/tailwind.css" />
            <link rel="stylesheet" href="/static/style.css" />
            <link rel="stylesheet" href="/static/shopper.css" />
            <link rel="stylesheet" href="/static/admin.css" />
        </head>
        <body class="relative min-h-screen text-[#faf7f2] bg-[#14110d] overflow-x-hidden">
            if title == "Dashboard" {
                @AdminHeader()
            } else {
                @Header()
            <div id="deactivateModal" class="deactivate-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="deactivateModalTitle" hidden>
                <div class="deactivate-modal-panel">
                    <span class="deactivate-modal-eyebrow">Bliss Atelier · Account Security</span>
                    <h2 id="deactivateModalTitle">Deactivate Account</h2>
                    <p id="deactivateModalStep1">
                        Deactivating your account will immediately terminate all active sessions across all devices. You will not be able to log back in until staff review and reactivate your account.
                    </p>
                    <p id="deactivateModalStep2" hidden class="deactivate-warning">
                        Are you absolutely certain? This will immediately lock your access and purge all multi-device sessions.
                    </p>
                    <div id="deactivateModalError" class="deactivate-error" role="alert" hidden></div>
                    <div class="deactivate-modal-actions">
                        <button id="deactivateModalCancel" type="button" class="deactivate-btn-cancel">Keep Account</button>
                        <button id="deactivateModalConfirm" type="button" class="deactivate-btn-confirm" data-mutation>Deactivate</button>
                    </div>
                </div>
            </div>
            }
            for _, child := range children {
                @child
            }
            @Footer()
            @OfflineOverlay()
            <button id="backToTopBtn" class="back-to-top" aria-label="Back to top">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-5 h-5"
                    fill="currentColor"
                >
                    <path
                        d="M12 5.5a.75.75 0 0 1 .53.22l5 5a.75.75 0 0 1-1.06 1.06L12 7.31l-4.47 4.47a.75.75 0 0 1-1.06-1.06l5-5A.75.75 0 0 1 12 5.5Zm0 6a.75.75 0 0 1 .53.22l5 5a.75.75 0 0 1-1.06 1.06L12 13.31l-4.47 4.47a.75.75 0 1 1-1.06-1.06l5-5A.75.75 0 0 1 12 11.5Z"
                    />
                </svg>
            </button>
            if len(products) > 0 {
                @templ.Raw("<script id=\"catalogData\" type=\"application/json\">" + catalogJSON(products) + "</script>")
            }
            <script src="/static/shared.js"></script>
            <script src="/static/shopper.js"></script>
            if pageScript != "" {
                <script src={ pageScript }></script>
            }
        </body>
    </html>
}

templ OfflineOverlay() {
 <dialog id="offlineOverlay" role="alertdialog" aria-modal="true" aria-labelledby="offlineTitle" aria-describedby="offlineDescription" tabindex="-1" hidden>
  <div>
   <video id="offlineVideo" width="180" height="210" autoplay loop muted playsinline aria-hidden="true" hidden><source src="/static/empty-atomizer.webm" type="video/webm"/></video>
   <svg id="offlineAtomizer" class="offline-atomizer" viewBox="0 0 150 170" fill="none" aria-hidden="true"><rect x="28" y="65" width="75" height="95" rx="15" stroke="currentColor" stroke-width="2"/><path d="M35 136h61M65 65v73" stroke="currentColor" stroke-opacity=".3"/><rect x="48" y="45" width="34" height="20" rx="3" stroke="currentColor" stroke-width="2"/><g class="atomizer-head"><rect x="48" y="28" width="40" height="17" rx="3" stroke="currentColor" stroke-width="2"/><path d="M88 36h8" stroke="currentColor" stroke-width="3"/></g><g class="atomizer-mist" stroke="currentColor" stroke-linecap="round"><path d="m103 32 23-8m-23 12h29m-29 4 23 9"/></g><text x="65" y="104" fill="currentColor" text-anchor="middle" font-size="12">BLISS</text><text x="65" y="122" fill="currentColor" text-anchor="middle" font-size="7">EMPTY ATOMIZER</text></svg>
   <h2 id="offlineTitle">The Scent Is Paused</h2>
   <p id="offlineDescription">Connection dropped. Your current inputs are held safely on this page.</p>
   <span id="offlineBadge" class="offline-badge" role="status">Connection retrying...</span>
  </div>
 </dialog>
}

templ Header() {
	<header id="top" class="site-header sticky top-0 z-10">
		<div class="site-header-inner">
			<a href="/" class="site-brand" aria-label="Bliss Atelier Perfumes home">
				<span class="site-monogram" aria-hidden="true">BP</span>
				<span class="site-brand-copy">
					<span class="site-brand-name">Bliss Atelier Perfumes</span>
					<span class="site-brand-location">Mombasa · Kenya</span>
				</span>
			</a>
			<nav class="site-nav" aria-label="Main navigation">
				<a href="/#collection">Collection</a>
				<a href="/dashboard">Dashboard</a>
			</nav>
			<details id="accountMenu" class="account-menu">
				<summary aria-label="Open account menu">
					<svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.5"></circle><path d="M5 20c.6-3.3 3.2-5 7-5s6.4 1.7 7 5"></path></svg>
					<span class="sr-only">Account</span>
				</summary>
				<div class="account-dropdown">
					<div id="shopperProfile" class="shopper-profile" aria-live="polite">
						<a id="shopperSignIn" href="/api/auth/google?return_url=/checkout">Sign in with Google</a>
						<img id="shopperAvatar" width="36" height="36" alt="" hidden/>
						<span id="shopperName" hidden></span>
						<button id="shopperLogout" type="button" data-mutation hidden>Sign out</button>
						<button id="shopperDeactivate" type="button" class="shopper-deactivate-btn" data-mutation hidden>Deactivate account</button>
						<a id="resumeOrder" href="/checkout" hidden>Resume order</a>
						<span id="shopperAuthMessage" role="status"></span>
					</div>
					<a class="account-dashboard" href="/dashboard">Atelier dashboard</a>
				</div>
			</details>
			<button type="button" data-open-cart class="site-cart" aria-label="Open cart">
				<svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 1.9-1.5L20 9H6"></path><circle cx="9.5" cy="20" r="1"></circle><circle cx="17.5" cy="20" r="1"></circle></svg>
				<span data-cart-count class="site-cart-count">0</span>
			</button>
		</div>
	</header>
}

templ Footer() {
    <footer class="site-footer mt-16">
        <div class="max-w-6xl mx-auto px-4 py-12 space-y-8">
            <div class="footer-grid">
                <div>
                    <div
                        class="lux-brand text-[#dec9a8] tracking-[0.18em] text-sm uppercase font-semibold"
                    >
                        Bliss Atelier Perfumes
                    </div>
                    <p class="text-[#c9bfb1] text-sm mt-3 leading-relaxed">
                        Curated scents sourced from Paris, Dubai, Nairobi, and beyond.
                        Designed for the quietly powerful.
                    </p>
                    <p class="text-[#c8bba7] text-xs mt-3">
                        Showroom · SBS MARKITI COMPLEX SHOP 2, MOMBASA
                    </p>
                </div>
                <div>
                    <h4
                        class="text-[#d8c4a1] font-semibold text-xs uppercase tracking-[0.2em]"
                    >
                        Quick Links
                    </h4>
                    <div class="mt-3 space-y-2">
                        <a href="/" class="footer-link">Collection</a>
                        <a href="/dashboard" class="footer-link">Operations Dashboard</a>
                        <a href="/cart" class="footer-link">Shopping Cart</a>
                        <a href="/checkout" class="footer-link">Checkout</a>
                    </div>
                </div>
                <div id="visit">
                    <h4
                        class="text-[#d8c4a1] font-semibold text-xs uppercase tracking-[0.2em]"
                    >
                        Visit &amp; Hours
                    </h4>
                    <div class="mt-3 text-sm text-[#c9bfb1] space-y-1">
                        <p>Mon–Fri · 9am – 7pm</p>
                        <p>Sat · 10am – 6pm</p>
                        <p>Sun · By appointment</p>
                        <p class="text-[#c8bba7] text-xs mt-3">
                            Secure parking · private sniff sessions
                        </p>
                    </div>
                </div>
                <div id="contact">
                    <h4
                        class="text-[#d8c4a1] font-semibold text-xs uppercase tracking-[0.2em]"
                    >
                        Social &amp; Contact
                    </h4>
                    <div class="mt-3 flex gap-3">
                        <a
                            href="https://www.instagram.com/bliss_atelier_perfumes/"
                            class="social-btn"
                            aria-label="Instagram"
                            target="_blank"
                            rel="noreferrer"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                class="w-4 h-4"
                                fill="currentColor"
                            >
                                <path
                                    d="M8 3a5 5 0 0 0-5 5v8a5 5 0 0 0 5 5h8a5 5 0 0 0 5-5V8a5 5 0 0 0-5-5H8Zm0 1.5h8A3.5 3.5 0 0 1 19.5 8v8a3.5 3.5 0 0 1-3.5 3.5H8A3.5 3.5 0 0 1 4.5 16V8A3.5 3.5 0 0 1 8 4.5Zm8.38 1.62a.88.88 0 1 0 0 1.76.88.88 0 0 0 0-1.76ZM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 1.5A3.5 3.5 0 1 1 8.5 12 3.5 3.5 0 0 1 12 8.5Z"
                                />
                            </svg>
                        </a>
                        <a
                            href="https://www.instagram.com/bliss_atelier_perfumes/"
                            class="social-btn"
                            aria-label="TikTok"
                            target="_blank"
                            rel="noreferrer"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                class="w-4 h-4"
                                fill="currentColor"
                            >
                                <path
                                    d="M13.5 3h2.25a4 4 0 0 0 3.1 3.1V8.5a6.5 6.5 0 0 1-3.1-.8v6.3a5 5 0 1 1-5-5c.17 0 .34.01.5.03V9.5a2.5 2.5 0 1 0 2 2.45V3Z"
                                />
                            </svg>
                        </a>
                        <a href="#" class="social-btn" aria-label="Pinterest">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                class="w-4 h-4"
                                fill="currentColor"
                            >
                                <path
                                    d="M12 3.5A6.5 6.5 0 0 0 9 16.06l-.88 3.56a.5.5 0 0 0 .85.45l2.05-2.08a6.5 6.5 0 1 0 1-14Z"
                                />
                            </svg>
                        </a>
                    </div>
                    <a
                        id="whatsappLink"
                        href="#"
                        target="_blank"
                        rel="noreferrer"
                        class="mt-4 inline-flex items-center gap-2 px-4 py-2.5 rounded-[10px] gold-outline-btn w-full sm:w-auto text-sm font-semibold"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            class="w-4 h-4"
                            fill="currentColor"
                        >
                            <path
                                d="M19.5 4.5A8.96 8.96 0 0 0 12 1a9 9 0 0 0-7.78 13.33l-1.18 4.3a.75.75 0 0 0 .92.92l4.3-1.18A9 9 0 0 0 12 21a9 9 0 0 0 7.5-16.5Zm-7.5 13.5c-1.35 0-2.66-.36-3.82-1.05a.75.75 0 0 0-.61-.07l-2.53.69.69-2.53a.75.75 0 0 0-.07-.61A6.51 6.51 0 0 1 5.5 9a6.5 6.5 0 1 1 6.5 9Zm3.2-4.14c-.18-.09-1.08-.54-1.25-.6-.17-.07-.3-.09-.43.09s-.49.6-.6.72-.22.13-.4.04a5.32 5.32 0 0 1-2.69-2.35c-.2-.34.2-.32.55-1.06.06-.13.03-.24-.02-.33-.04-.09-.43-1.03-.59-1.41-.15-.36-.3-.31-.43-.32l-.36-.01c-.13 0-.33.05-.5.24-.17.2-.65.64-.65 1.56s.67 1.8.76 1.92c.09.13 1.32 2.02 3.21 2.83.45.2.8.31 1.07.4.45.14.86.12 1.18.07.36-.05 1.08-.44 1.23-.86.15-.42.15-.78.1-.86-.05-.09-.17-.13-.35-.22Z"
                            />
                        </svg>
                        <span>Chat on WhatsApp</span>
                    </a>
                </div>
            </div>
            <div
                class="border-t border-[#4a3e30] pt-6 text-xs text-[#c8bba7] flex flex-col gap-3"
            >
                <p class="footer-privacy-note">
                    We use essential browser storage for your cart and anonymous, session-only analytics (no advertising cookies) to improve our collection and fulfill orders.
                </p>
                <div class="flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between">
                    <p>
                        &copy; 2026 Bliss Atelier Perfumes · Crafted with intention in Mombasa.
                    </p>
                    <p>
                        <button
                            id="privacyNoticeTrigger"
                            type="button"
                            class="footer-privacy-btn"
                        >
                            Privacy Notice
                        </button>
                        <span> · Terms · Returns within 7 days unopened.</span>
                    </p>
                </div>
            </div>
        </div>
        <div
            id="privacyModal"
            class="deactivate-modal-overlay"
            role="dialog"
            aria-modal="true"
            aria-labelledby="privacyModalTitle"
            hidden
        >
            <div class="deactivate-modal-panel">
                <span class="deactivate-modal-eyebrow">Bliss Atelier · Transparency</span>
                <h2 id="privacyModalTitle">Privacy &amp; Data Notice</h2>
                <p>
                    <strong>Browsing &amp; Session Activity:</strong> We record anonymous, session-only store interactions (catalog views, cart additions, checkout starts, and payment initiation) using a temporary browser tab ID. We do not use advertising cookies or cross-site tracking, and session events are automatically purged after 90 days.
                </p>
                <p>
                    <strong>Orders &amp; Delivery:</strong> When you place an order, we collect your name, M-Pesa phone number, and delivery location solely to fulfill your order, quote transport, handle exchanges, and maintain payment and inventory records.
                </p>
                <p>
                    <strong>Store Insights:</strong> Aggregated, non-personal sales, stock, and conversion metrics help us improve product availability and store performance.
                </p>
                <div class="deactivate-modal-actions">
                    <button id="privacyModalClose" type="button" class="deactivate-btn-cancel">Close</button>
                </div>
            </div>
        </div>
    </footer>
}
