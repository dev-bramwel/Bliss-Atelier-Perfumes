package web

import "github.com/dev-bramwel/Bliss-Atelier-Perfumes/internal/catalog"

templ AdminHeader() {
 <header class="admin-brandbar"><a href="/admin" class="lux-brand">Bliss Atelier <span>Operations</span></a><a href="/">View storefront ↗</a></header>
}

templ DashboardPage(products []catalog.Product) {
 <main id="adminApp" class="admin-shell" aria-labelledby="adminTitle">
  <header class="admin-heading">
   <div><p class="admin-eyebrow">Bliss Atelier · Mombasa</p><h1 id="adminTitle">Atelier operations</h1><p>Orders, stock and the people behind every scent.</p></div>
   <div id="adminProfile" aria-live="polite"><span id="staffName">Checking your session…</span><span id="staffEmail"></span><strong id="staffRole"></strong><button id="adminLogout" type="button" data-mutation hidden>Sign out</button></div>
  </header>
  <p id="adminMessage" class="admin-message" role="status" aria-live="polite" hidden></p>
  <section id="adminSignIn" class="admin-panel" hidden><h2>Staff sign-in required</h2><p id="signInReason">Use your approved Google account to manage the atelier.</p><a id="adminLogin" class="admin-button" href="/api/auth/google?return_url=/admin">Sign in with Google</a><a href="/">Return to the collection</a></section>
  <div id="adminWorkspace" hidden>
   <nav class="admin-nav" aria-label="Atelier administration">
    <a href="/admin/orders" data-section="orders">Orders &amp; fulfillment</a>
    <a href="/admin/inventory" data-section="inventory" data-inventory hidden>Catalog &amp; inventory</a>
    <a href="/admin/payments" data-section="payments" data-owner hidden>Payment exceptions</a>
    <a href="/admin/users" data-section="users" data-owner hidden>Users</a>
    <a href="/admin/audit-logs" data-section="audit-logs" data-owner hidden>Security audit</a>
   </nav>
   <section class="admin-metrics" aria-label="Operational metrics">
    <article><span>Catalog fragrances</span><strong id="metricCatalog">—</strong></article>
    <article><span>Common bottle price</span><strong id="metricPrice">—</strong></article>
    <article><span>Staged counter sales</span><strong id="metricStaged">0</strong><small>Apply verified batches using the stock tool</small></article>
    <article><span>Pending dispatch</span><strong id="metricDispatch">—</strong></article>
   </section>
   <section id="panelOrders" class="admin-panel" data-panel="orders" hidden>
    <div class="admin-section-heading"><div><h2>Orders &amp; fulfillment</h2><p id="orderScope">Live orders from the authoritative database.</p></div><button type="button" data-refresh="orders">Refresh orders</button></div>
    <div class="admin-table-wrap"><table><caption class="sr-only">Orders, payment and delivery status</caption><thead><tr><th>Order</th><th>Customer / location</th><th>Total</th><th>Payment</th><th>Fulfillment</th><th>Delivery quote</th><th>Actions</th></tr></thead><tbody id="ordersRows"></tbody></table></div>
    @AdminPager("orders")
   </section>
   <section id="panelInventory" class="admin-panel" data-panel="inventory" hidden>
    <div class="admin-section-heading"><div><h2>Catalog &amp; inventory</h2><p>Ledger stock minus active checkout holds. Holds expire after 15 minutes.</p><p id="inventoryApproval"></p></div><div><button type="button" data-refresh="inventory">Refresh stock</button><button id="btnAddInventory" type="button" data-mutation data-inventory hidden>Add inventory</button><button id="invalidateCatalog" type="button" data-mutation data-inventory hidden>Invalidate catalog cache</button></div></div>
    <div class="admin-table-wrap"><table><caption class="sr-only">Product prices and stock holds</caption><thead><tr><th>Product</th><th>Price</th><th>Ledger stock</th><th>Active holds</th><th>Unreserved</th><th>Opening count</th></tr></thead><tbody id="inventoryRows"></tbody></table></div>
    @AdminPager("inventory")
   </section>
   <section id="panelPayments" data-panel="payments" class="admin-panel" hidden>
    <div class="admin-section-heading"><div><h2>Payment exceptions</h2><p>Inspect evidence before recording any financial resolution.</p></div><button type="button" data-refresh="payments">Refresh payments</button></div>
    <label>Exception status<select id="exceptionFilter"><option value="open">Open</option><option value="resolved">Resolved</option><option value="dismissed">Dismissed</option><option value="all">All</option></select></label>
    <div class="admin-table-wrap"><table><caption class="sr-only">Payment exceptions</caption><thead><tr><th>Created</th><th>Type</th><th>Order / receipt</th><th>Received / expected</th><th>Status</th><th>Action</th></tr></thead><tbody id="exceptionsRows"></tbody></table></div>
    @AdminPager("exceptions")
    <div class="admin-section-heading"><h3>Unresolved STK attempts</h3><button id="runReconciliation" type="button" data-mutation>Run reconciliation</button></div>
    <div class="admin-table-wrap"><table><caption class="sr-only">Unresolved payment attempts</caption><thead><tr><th>Order</th><th>Amount</th><th>Status</th><th>Queries</th><th>Next query</th></tr></thead><tbody id="unresolvedRows"></tbody></table></div>
    @AdminPager("unresolved")
    <button id="openSettlement" type="button">Record verified manual settlement</button>
    <h3>Immutable payment audit ledger</h3>
    <div class="admin-table-wrap"><table><caption class="sr-only">Manual settlements and corrections</caption><thead><tr><th>Time</th><th>Order / action</th><th>Amount / receipt</th><th>Authorized by</th><th>Evidence / notes</th></tr></thead><tbody id="paymentAuditRows"></tbody></table></div>
    @AdminPager("paymentAudit")
   </section>
   <section id="panelUsers" data-panel="users" class="admin-panel" hidden>
    <div class="admin-section-heading"><div><h2>User administration</h2><p>Role changes and deactivation immediately revoke the affected account’s sessions.</p></div><button type="button" data-refresh="users">Refresh users</button></div>
    <div class="admin-table-wrap"><table><caption class="sr-only">Users visible to your role</caption><thead><tr><th>User ID</th><th>Name / email</th><th>Role</th><th>Active</th><th>Created</th><th>Actions</th></tr></thead><tbody id="usersRows"></tbody></table></div>
    @AdminPager("users")
   </section>
   <section id="panelAudit" data-panel="audit-logs" class="admin-panel" hidden>
    <div class="admin-section-heading"><div><h2>Security audit logs</h2><p>Times shown in Africa/Nairobi. Owner events are visible only to owners.</p></div><button type="button" data-refresh="audit-logs">Refresh audit</button></div>
    <div class="admin-table-wrap"><table><caption class="sr-only">Administrative security events</caption><thead><tr><th>Timestamp</th><th>Actor / role</th><th>Action</th><th>Resource</th><th>IP address</th><th>Metadata</th></tr></thead><tbody id="auditRows"></tbody></table></div>
    @AdminPager("audit")
   </section>
   <p id="adminUpdated" class="admin-updated" aria-live="polite"></p>
  </div>
  <dialog id="orderDialog" class="admin-dialog" aria-labelledby="orderDialogTitle"><div class="admin-dialog-heading"><h2 id="orderDialogTitle">Order details</h2><button type="button" data-close-dialog aria-label="Close order details">Close</button></div><div id="orderDetails"></div>
   <form id="quoteForm" data-owner hidden><h3>Issue delivery quote</h3><label>Transport fee (KES)<input name="fee_kes" type="number" min="1" max="1000000" step="1" required/></label><label>Delivery note<textarea name="notes" maxlength="1000"></textarea></label><button type="submit" data-mutation>Issue quote</button><p id="quoteStatus" aria-live="polite"></p></form>
   <form id="assignForm" data-owner hidden><h3>Assign to employee</h3><label>Employee user ID<input name="user_id" maxlength="128" required/></label><button type="submit" data-mutation>Assign order</button></form>
   <button id="fulfillOrder" type="button" data-mutation hidden>Mark dispatched / collected</button>
  </dialog>
  <dialog id="exceptionDialog" class="admin-dialog" aria-labelledby="exceptionDialogTitle"><div class="admin-dialog-heading"><h2 id="exceptionDialogTitle">Resolve payment exception</h2><button type="button" data-close-dialog aria-label="Close payment exception">Close</button></div><div id="exceptionDetails"></div>
   <form id="resolveForm"><label>Resolution action<select name="action" required><option value="applied_to_order">Applied to order</option><option value="refund_recorded">Refund recorded</option><option value="dismissed_duplicate">Dismissed duplicate</option><option value="voided">Voided</option></select></label><label>Resolution notes<textarea name="resolution_notes" maxlength="2000" required></textarea></label><label>Evidence reference<input name="evidence" maxlength="512" required/></label><button type="submit" data-mutation>Resolve exception</button></form>
  </dialog>
  <dialog id="settlementDialog" class="admin-dialog" aria-labelledby="settlementDialogTitle"><div class="admin-dialog-heading"><h2 id="settlementDialogTitle">Verified manual settlement</h2><button type="button" data-close-dialog aria-label="Close manual settlement">Close</button></div><form id="settlementForm"><label>Order ID<input name="order_id" maxlength="128" required/></label><label>Amount (KES)<input name="amount_kes" type="number" min="1" max="1000000" step="1" required/></label><label>M-Pesa receipt number<input name="receipt_number" maxlength="128" required/></label><label>Evidence reference<input name="evidence" maxlength="512" required/></label><label>Notes<textarea name="notes" maxlength="2000" required></textarea></label><button type="submit" data-mutation>Record manual settlement</button></form></dialog>
  <dialog id="addInventoryDialog" class="admin-dialog" aria-labelledby="addInventoryTitle"><div class="admin-dialog-heading"><h2 id="addInventoryTitle">Add inventory</h2><button type="button" data-close-dialog aria-label="Close add inventory">Close</button></div><form id="addInventoryForm"><label>Product<select id="restockProduct" name="product_id" required></select></label><label>Quantity added<input name="quantity" type="number" min="1" max="1000000" step="1" required/></label><label>Reference / Batch note<input name="reference" maxlength="512" placeholder="e.g. Shipment arrival batch INV-2026-11-24" required/></label><button type="submit" data-mutation>Confirm restock</button><p id="addInventoryStatus" class="admin-dialog-status" aria-live="polite"></p></form></dialog>
  <noscript><p>Enable JavaScript to sign in and use the operations dashboard.</p></noscript>
 </main>
}

templ AdminPager(name string) {
 <div class="admin-pager" data-pager={name}><button type="button" data-page-prev={name}>Previous</button><span data-page-label={name}>Page 1</span><button type="button" data-page-next={name}>Next</button></div>
}
