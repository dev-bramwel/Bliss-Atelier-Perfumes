package web

templ CartPage() {
    <main class="max-w-4xl mx-auto px-4 py-10">
        <div class="glass-panel p-6 sm:p-8">
            <div class="flex items-center justify-between mb-6">
                <h1 class="text-2xl sm:text-3xl font-display text-white">
                    Your Cart
                </h1>
                <span class="text-sm text-gray-400">
                    <span data-cart-count>0</span> item(s)
                </span>
            </div>
            <div id="cartItems" class="space-y-3"></div>
            <div
                id="cartFooter"
                class="mt-6 border-t border-white/10 pt-5 space-y-4"
            >
                <div class="flex items-center justify-between text-base">
                    <span class="text-gray-300 font-medium">Total</span>
                    <span class="text-white font-semibold text-lg">
                        KES <span id="cartTotal">0</span>
                    </span>
                </div>
                <button
                    id="toCheckoutBtn"
                    class="w-full py-3 rounded-2xl gold-btn font-medium disabled:opacity-40 disabled:cursor-not-allowed"
                    disabled
                >
                    Continue to Checkout
                </button>
                <button
                    id="clearCartBtn"
                    class="w-full py-2 rounded-2xl border border-white/15 text-sm text-gray-300 hover:text-white hover:border-white/40 disabled:opacity-40 disabled:cursor-not-allowed"
                    disabled
                >
                    Clear Cart
                </button>
                <p class="text-xs text-gray-500 text-center">
                    Store-first: payments come later (Stripe / PayPal / M-Pesa).
                </p>
            </div>
        </div>
    </main>
    <script src="/static/cart.js"></script>
}
