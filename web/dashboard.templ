package web

import (
	"fmt"
	"github.com/dev-bramwel/Bliss-Atelier-Perfumes/internal/catalog"
)

templ DashboardPage(products []catalog.Product) {
	<main class="max-w-6xl mx-auto px-4 py-8 space-y-8">
		<!-- Header Banner -->
		<section class="glass-panel p-6 sm:p-8">
			<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
				<div class="space-y-1.5">
					<div class="flex items-center gap-2">
						<span class="dash-badge dash-badge-khaki">Atelier Operations</span>
						<span class="dash-badge dash-badge-espresso">Mombasa, Kenya</span>
					</div>
					<h1 class="text-2xl sm:text-3xl font-display font-semibold text-[#faf7f2]">
						Operations Dashboard
					</h1>
					<p class="text-sm text-[rgba(247,243,235,0.68)] max-w-xl">
						Live catalog overview, counter sale recording, and Mombasa delivery &amp; pickup pipeline.
					</p>
				</div>
				<div class="flex flex-wrap items-center gap-2">
					<span class="dash-badge dash-badge-success">
						<span class="w-2 h-2 rounded-full bg-[#c6b79b] animate-pulse"></span>
						Catalog Live
					</span>
					<span class="dash-badge dash-badge-espresso">Standard KES 2,500 Price</span>
					<span class="dash-badge dash-badge-khaki">Pay Pre-Dispatch</span>
				</div>
			</div>
		</section>

		<!-- 4 Key Metric Cards -->
		<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			<div class="dash-metric-card">
				<p class="text-xs uppercase tracking-[0.16em] text-[var(--gold-soft)] font-medium">Catalog Fragrances</p>
				<h3 class="text-2xl font-display font-semibold text-[#faf7f2] mt-1.5">
					<span id="dashTotalScents">{ fmt.Sprintf("%d", len(products)) }</span>
					<span class="text-sm font-sans font-normal text-[rgba(247,243,235,0.5)]">Bottles</span>
				</h3>
				<p class="text-xs text-[rgba(247,243,235,0.55)] mt-1">100ml Signature Eau de Parfum</p>
			</div>

			<div class="dash-metric-card">
				<p class="text-xs uppercase tracking-[0.16em] text-[var(--gold-soft)] font-medium">Common Bottle Price</p>
				<h3 class="text-2xl font-display font-semibold text-[#faf7f2] mt-1.5">
					KES 2,500
				</h3>
				<p class="text-xs text-[rgba(247,243,235,0.55)] mt-1">Approved Uniform Atelier Pricing</p>
			</div>

			<div class="dash-metric-card">
				<p class="text-xs uppercase tracking-[0.16em] text-[var(--gold-soft)] font-medium">Verified Counter Sales</p>
				<h3 class="text-2xl font-display font-semibold text-[#faf7f2] mt-1.5">
					<span id="dashSalesCount">0</span>
					<span class="text-sm font-sans font-normal text-[rgba(247,243,235,0.5)]">Sales</span>
				</h3>
				<p class="text-xs text-[rgba(247,243,235,0.55)] mt-1">
					KES <span id="dashSalesTotal">0</span> recorded
				</p>
			</div>

			<div class="dash-metric-card">
				<p class="text-xs uppercase tracking-[0.16em] text-[var(--gold-soft)] font-medium">Fulfillment Queue</p>
				<h3 class="text-2xl font-display font-semibold text-[#faf7f2] mt-1.5">
					<span id="dashOrdersCount">0</span>
					<span class="text-sm font-sans font-normal text-[rgba(247,243,235,0.5)]">Orders</span>
				</h3>
				<p class="text-xs text-[rgba(247,243,235,0.55)] mt-1">Mombasa Delivery &amp; Pickup</p>
			</div>
		</section>

		<!-- Dashboard Tabs -->
		<section class="space-y-6">
			<div class="flex items-center gap-2 overflow-x-auto pb-1 border-b border-[rgba(214,199,175,0.12)]">
				<button class="dash-tab-btn active" data-tab-target="fast-sale">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
					</svg>
					Fast Sale Entry
				</button>
				<button class="dash-tab-btn" data-tab-target="orders-queue">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
					</svg>
					Orders &amp; Sales Queue
				</button>
				<button class="dash-tab-btn" data-tab-target="catalog-inventory">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
					</svg>
					Catalog &amp; Stock
				</button>
				<button class="dash-tab-btn" data-tab-target="policy-scope">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
					</svg>
					Operating Policies
				</button>
			</div>

			<!-- TAB 1: Fast Sale Entry -->
			<div id="tab-fast-sale" class="dash-tab-content space-y-6">
				<div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 items-start">
					<!-- Sale Recording Form -->
					<div class="glass-panel p-6 sm:p-8 space-y-5">
						<div>
							<h3 class="text-xl font-display font-semibold text-[#faf7f2]">Record Verified Counter Sale</h3>
							<p class="text-xs text-[rgba(247,243,235,0.65)] mt-1">
								Fast sale entry for shop operators. Stock updates immediately and is logged for administrative review.
							</p>
						</div>

						<form id="fastSaleForm" class="space-y-4">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label class="text-xs block mb-1 text-[rgba(247,243,235,0.75)]">Fragrance</label>
									<select id="saleFragranceSelect" required class="w-full glass-field rounded-2xl px-3.5 py-2.5 text-sm">
										<option value="">Select Fragrance...</option>
										for _, p := range products {
											<option value={ p.ID } data-price={ fmt.Sprintf("%d", p.PriceKes) }>
												{ p.Name } ({ p.Size } &bull; KES { formatPriceKes(p.PriceKes) })
											</option>
										}
									</select>
								</div>
								<div>
									<label class="text-xs block mb-1 text-[rgba(247,243,235,0.75)]">Bottle Quantity</label>
									<input
										id="saleQuantity"
										type="number"
										min="1"
										max="20"
										value="1"
										required
										class="w-full glass-field rounded-2xl px-3.5 py-2.5 text-sm"
									/>
								</div>
							</div>

							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label class="text-xs block mb-1 text-[rgba(247,243,235,0.75)]">Shop Operator / Employee</label>
									<select id="saleOperator" required class="w-full glass-field rounded-2xl px-3.5 py-2.5 text-sm">
										<option value="Employee 1">Shop Employee 1</option>
										<option value="Employee 2">Shop Employee 2</option>
										<option value="Owner">Atelier Owner</option>
									</select>
								</div>
								<div>
									<label class="text-xs block mb-1 text-[rgba(247,243,235,0.75)]">Payment Verification</label>
									<select id="salePaymentType" required class="w-full glass-field rounded-2xl px-3.5 py-2.5 text-sm">
										<option value="mpesa_stk">M-Pesa STK (Confirmed Prompt)</option>
										<option value="mpesa_counter">M-Pesa Till / Paybill (Verified Receipt)</option>
										<option value="cash_counter">Cash Counter (Inspected at Register)</option>
									</select>
								</div>
							</div>

							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label class="text-xs block mb-1 text-[rgba(247,243,235,0.75)]">M-Pesa Code / Receipt Ref</label>
									<input
										id="saleReceiptRef"
										required
										placeholder="e.g. QJD78K92L..."
										class="w-full glass-field rounded-2xl px-3.5 py-2.5 text-sm"
									/>
								</div>
								<div>
									<label class="text-xs block mb-1 text-[rgba(247,243,235,0.75)]">Customer Phone (Optional)</label>
									<input
										id="saleCustomerPhone"
										placeholder="07xx... (for receipts/alerts)"
										class="w-full glass-field rounded-2xl px-3.5 py-2.5 text-sm"
									/>
								</div>
							</div>

							<div>
								<label class="text-xs block mb-1 text-[rgba(247,243,235,0.75)]">Sale Notes (Optional)</label>
								<input
									id="saleNotes"
									placeholder="e.g. Complimentary gift bag, repeat client"
									class="w-full glass-field rounded-2xl px-3.5 py-2.5 text-sm"
								/>
							</div>

							<div class="pt-3 border-t border-[rgba(214,199,175,0.12)] flex items-center justify-between">
								<div>
									<span class="text-xs text-[rgba(247,243,235,0.6)]">Calculated Total:</span>
									<div class="text-lg font-semibold text-[#faf7f2]">
										KES <span id="saleCalculatedTotal">2,500</span>
									</div>
								</div>
								<button type="submit" class="py-2.5 px-6 rounded-2xl gold-btn text-sm font-semibold">
									Record Verified Sale
								</button>
							</div>
						</form>
					</div>

					<!-- Operating Guide Card -->
					<div class="space-y-4">
						<div class="glass-panel p-5 space-y-3">
							<h4 class="text-sm font-semibold uppercase tracking-[0.2em] text-[var(--gold-soft)]">
								Operator Policy Rule
							</h4>
							<p class="text-xs text-[rgba(247,243,235,0.7)] leading-relaxed">
								Per R01 operating policy, all sales must be verified before handover or dispatch. Entry is immediate to prevent stock races; the owner reviews recorded sales afterward without deducting stock again.
							</p>
							<div class="text-xs text-[rgba(247,243,235,0.5)] pt-2 border-t border-white/5 space-y-1">
								<p>&bull; Mombasa SBS Markiti Complex Shop 2</p>
								<p>&bull; Common bottle price: KES 2,500</p>
								<p>&bull; 2-day exchange window for unopened bottles</p>
							</div>
						</div>

						<div class="glass-panel p-5 space-y-2">
							<div class="flex items-center justify-between">
								<h4 class="text-xs font-semibold uppercase tracking-[0.16em] text-[rgba(247,243,235,0.8)]">
									Quick Actions
								</h4>
							</div>
							<div class="flex flex-col gap-2 pt-1">
								<a href="/" class="py-2 px-3 rounded-xl border border-white/10 text-xs text-center text-gray-300 hover:bg-white/5 transition">
									Browse Storefront Collection &rarr;
								</a>
								<a href="/checkout" class="py-2 px-3 rounded-xl border border-white/10 text-xs text-center text-gray-300 hover:bg-white/5 transition">
									Open Guest Checkout &rarr;
								</a>
							</div>
						</div>
					</div>
				</div>

				<!-- Recent Counter Sales Table -->
				<div class="glass-panel p-6 space-y-4">
					<div class="flex items-center justify-between">
						<div>
							<h3 class="text-lg font-display font-semibold text-[#faf7f2]">Recent Counter Sales</h3>
							<p class="text-xs text-[rgba(247,243,235,0.6)]">Audited shop floor transactions recorded today.</p>
						</div>
						<button id="clearSalesHistoryBtn" class="text-xs text-gray-400 hover:text-white px-2 py-1 rounded-lg border border-white/10">
							Clear Local Log
						</button>
					</div>

					<div class="overflow-x-auto">
						<table class="w-full text-left text-sm">
							<thead class="text-xs uppercase tracking-[0.1em] text-[var(--gold-soft)] border-b border-white/10">
								<tr>
									<th class="py-2.5 px-3">Time</th>
									<th class="py-2.5 px-3">Fragrance</th>
									<th class="py-2.5 px-3">Qty</th>
									<th class="py-2.5 px-3">Amount</th>
									<th class="py-2.5 px-3">Operator</th>
									<th class="py-2.5 px-3">Verification / Ref</th>
									<th class="py-2.5 px-3">Status</th>
								</tr>
							</thead>
							<tbody id="recentSalesTbody" class="divide-y divide-white/5 text-xs text-gray-300">
								<!-- Dynamically populated -->
								<tr>
									<td colspan="7" class="py-6 text-center text-gray-500">
										No counter sales recorded yet today. Use the form above to record a verified sale.
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<!-- TAB 2: Orders & Sales Queue -->
			<div id="tab-orders-queue" class="dash-tab-content space-y-6 hidden">
				<div class="glass-panel p-6 space-y-4">
					<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
						<div>
							<div class="flex items-center gap-2">
								<h3 class="text-lg font-display font-semibold text-[#faf7f2]">Orders &amp; Fulfillment Queue</h3>
								<span id="orderSyncBadge" class="dash-badge dash-badge-khaki text-[10px]">Sync: Checking Server...</span>
							</div>
							<p class="text-xs text-[rgba(247,243,235,0.6)]">Live customer orders from checkout and counter sales.</p>
						</div>
						<div class="flex items-center gap-1.5 bg-black/40 p-1 rounded-2xl border border-white/10 text-xs">
							<button class="queue-filter-btn px-3 py-1 rounded-xl bg-[#c6b79b] text-[#120f0d] font-semibold" data-filter="all">
								All Activity
							</button>
							<button class="queue-filter-btn px-3 py-1 rounded-xl text-gray-300 hover:text-white" data-filter="online">
								Online Orders
							</button>
							<button class="queue-filter-btn px-3 py-1 rounded-xl text-gray-300 hover:text-white" data-filter="counter">
								Counter Sales
							</button>
						</div>
					</div>

					<div id="ordersQueueList" class="space-y-3">
						<!-- Dynamically populated -->
						<div class="py-8 text-center text-gray-500 text-sm">
							Loading orders queue...
						</div>
					</div>
				</div>
			</div>

			<!-- TAB 3: Catalog & Stock -->
			<div id="tab-catalog-inventory" class="dash-tab-content space-y-6 hidden">
				<div class="glass-panel p-6 space-y-4">
					<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
						<div>
							<h3 class="text-lg font-display font-semibold text-[#faf7f2]">Fragrance Catalog &amp; Inventory</h3>
							<p class="text-xs text-[rgba(247,243,235,0.6)]">Sourced from the PostgreSQL catalog and verified against active holdings.</p>
						</div>
						<input
							id="dashCatalogSearch"
							placeholder="Filter scents..."
							class="w-full sm:w-64 glass-field rounded-2xl px-3.5 py-1.5 text-xs"
						/>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3" id="dashCatalogGrid">
						for _, p := range products {
							{{ thumb := "" }}
							if len(p.Images) > 0 {
								{{ thumb = p.Images[0] }}
							}
							<div class="dash-metric-card p-4 flex items-center justify-between gap-3" data-name={ p.Name } data-category={ p.Category }>
								<div class="flex items-center gap-3 min-w-0">
									<div class="w-12 h-12 rounded-xl overflow-hidden bg-black/40 shrink-0 border border-white/10 flex items-center justify-center">
										if thumb != "" {
											<img src={ thumb } alt={ p.Name } class="w-full h-full object-cover" loading="lazy" onerror="this.style.display='none'" />
										}
									</div>
									<div class="min-w-0">
										<h4 class="text-sm font-semibold text-[#faf7f2] truncate">{ p.Name }</h4>
										<p class="text-xs text-[rgba(247,243,235,0.5)] truncate">{ p.Gender } &bull; { p.Category }</p>
										<p class="text-xs text-[var(--gold-soft)] font-medium">KES { formatPriceKes(p.PriceKes) }</p>
									</div>
								</div>
								<div class="shrink-0 text-right">
									if p.Available {
										<span class="dash-badge dash-badge-khaki text-[10px]">In Stock</span>
									} else {
										<span class="dash-badge dash-badge-espresso text-[10px]">Held</span>
									}
								</div>
							</div>
						}
					</div>
				</div>
			</div>

			<!-- TAB 4: Operating Policies Reference -->
			<div id="tab-policy-scope" class="dash-tab-content space-y-6 hidden">
				<div class="glass-panel p-6 sm:p-8 space-y-6">
					<div>
						<h3 class="text-xl font-display font-semibold text-[#faf7f2]">Approved R01 Operating Rules</h3>
						<p class="text-xs text-[rgba(247,243,235,0.65)] mt-1">
							Mandatory business rules approved for Bliss Atelier Perfumes release operations.
						</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div class="p-4 rounded-2xl bg-[rgba(255,250,240,0.03)] border border-white/10 space-y-2">
							<div class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-[#c6b79b]"></span>
								<h4 class="text-sm font-semibold text-[#faf7f2]">1. Payment Before Dispatch</h4>
							</div>
							<p class="text-xs text-[rgba(247,243,235,0.7)] leading-relaxed">
								Payment on delivery is prohibited. All orders must be paid and verified via M-Pesa STK push or verified counter payment before dispatch.
							</p>
						</div>

						<div class="p-4 rounded-2xl bg-[rgba(255,250,240,0.03)] border border-white/10 space-y-2">
							<div class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-[#c6b79b]"></span>
								<h4 class="text-sm font-semibold text-[#faf7f2]">2. Mombasa Fulfillment</h4>
							</div>
							<p class="text-xs text-[rgba(247,243,235,0.7)] leading-relaxed">
								Delivery covers all Mombasa areas; transport fees are quoted separately, approved by the customer, and added on top of the product order total.
							</p>
						</div>

						<div class="p-4 rounded-2xl bg-[rgba(255,250,240,0.03)] border border-white/10 space-y-2">
							<div class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-[#c6b79b]"></span>
								<h4 class="text-sm font-semibold text-[#faf7f2]">3. 2-Day Unopened Exchange</h4>
							</div>
							<p class="text-xs text-[rgba(247,243,235,0.7)] leading-relaxed">
								Only unused, unopened, unsprayed bottles qualify for exchange. The exchange window is strictly within the first two days after purchase at the shop.
							</p>
						</div>

						<div class="p-4 rounded-2xl bg-[rgba(255,250,240,0.03)] border border-white/10 space-y-2">
							<div class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-[#c6b79b]"></span>
								<h4 class="text-sm font-semibold text-[#faf7f2]">4. 15-Minute Checkout Hold</h4>
							</div>
							<p class="text-xs text-[rgba(247,243,235,0.7)] leading-relaxed">
								Stock is temporarily held for 15 minutes during customer checkout. Unpaid expired holds release availability; late payments enter manual reconciliation.
							</p>
						</div>

						<div class="p-4 rounded-2xl bg-[rgba(255,250,240,0.03)] border border-white/10 space-y-2">
							<div class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-[#c6b79b]"></span>
								<h4 class="text-sm font-semibold text-[#faf7f2]">5. Authoritative Stock Ledger (R09)</h4>
							</div>
							<p class="text-xs text-[rgba(247,243,235,0.7)] leading-relaxed">
								Public HTTP stock mutation is prohibited. Verified counter sales generate an immediate canonical batch payload for the authoritative stock ledger (<code class="text-xs text-[var(--gold-soft)]">cmd/stock apply</code>) using kind <code class="text-xs text-[var(--gold-soft)]">local_sale</code>.
							</p>
						</div>

						<div class="p-4 rounded-2xl bg-[rgba(255,250,240,0.03)] border border-white/10 space-y-2">
							<div class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-[#c6b79b]"></span>
								<h4 class="text-sm font-semibold text-[#faf7f2]">6. Server-Side Fulfillment Sync</h4>
							</div>
							<p class="text-xs text-[rgba(247,243,235,0.7)] leading-relaxed">
								Fulfillment queue synchronizes with the server-side orders endpoint when available to load orders from all customer devices, falling back to local session records when operating offline.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
}
