# Go does not load .env automatically. Export settings in your shell.
GO_HTTP_ADDR=127.0.0.1:5001
GO_IO_TIMEOUT=5s
GO_SHUTDOWN_TIMEOUT=10s
GO_DB_MAX_CONNECTIONS=4
