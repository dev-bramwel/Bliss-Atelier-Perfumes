# Go does not load .env automatically. Export settings in your shell.
GO_HTTP_ADDR=127.0.0.1:5001
GO_IO_TIMEOUT=5s
GO_SHUTDOWN_TIMEOUT=10s
GO_DB_MAX_CONNECTIONS=4
# Optional for API/worker foundation; required for every migrate command.
# GO_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Alternatively, read the DSN from a mounted secret (mutually exclusive with GO_DATABASE_URL):
# GO_DATABASE_URL_FILE=/run/secrets/runtime_url
# Compose only: require exact baseline catalog and restricted local schema attestation.
GO_REQUIRE_SCHEMA=false
