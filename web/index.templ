package web

import (
	"fmt"
	"github.com/dev-bramwel/Bliss-Atelier-Perfumes/internal/catalog"
)

templ IndexPage(products []catalog.Product) {
	<main class="max-w-6xl mx-auto px-4 py-10">
		<section id="collection" class="glass-panel hero-panel p-6 sm:p-8">
			<div
				class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-6 text-center sm:text-left"
			>
				<div class="space-y-1">
					<p
						class="uppercase tracking-[0.4em] text-xs text-[var(--gold-soft)]"
					>
						House of scent
					</p>
					<h1
						class="text-3xl sm:text-4xl font-semibold font-display text-white"
					>
						Bliss Atelier Perfumes
					</h1>
					<p class="text-gray-400 text-sm mt-1">
						Choose a scent. Become a different person.
					</p>
				</div>
				<div class="text-sm text-gray-300 text-center sm:text-right">
					Showing <span id="resultsCount">{ fmt.Sprintf("%d", len(products)) }</span>
				</div>
			</div>
			<section
				id="productGrid"
				class="product-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
			>
				for _, p := range products {
					@ProductCard(p)
				}
			</section>
		</section>
	</main>
	@ProductModal()
	@templ.Raw("<script id=\"catalogData\" type=\"application/json\">" + catalogJSON(products) + "</script>")
	<script src="/static/app.js"></script>
}

templ ProductCard(p catalog.Product) {
	{{ thumb := "" }}
	if len(p.Images) > 0 {
		{{ thumb = p.Images[0] }}
	}
	{{ gender := p.Gender }}
	if gender == "" {
		{{ gender = "Unisex" }}
	}
	<div class="glass-panel rounded-3xl overflow-hidden border border-white/10 flex flex-col">
		<div class="product-card-img" data-open-product={ p.ID }>
			<img
				src={ thumb }
				alt={ p.Name }
				onerror="this.onerror=null;this.classList.add('img-broken')"
				loading="lazy"
			/>
			<div class="product-card-img-placeholder">
				<span>
					if len(p.Name) > 0 {
						{ string([]rune(p.Name)[0:1]) }
					}
				</span>
			</div>
			<div class="product-card-img-overlay">
				<span class="product-card-view-btn">View Details</span>
			</div>
		</div>
		<div class="p-5 flex flex-col flex-1">
			<div class="flex items-start justify-between gap-3">
				<div>
					<div class="text-xs uppercase tracking-[0.35em] text-[var(--gold-soft)]">
						{ gender } &bull; { p.Category }
					</div>
					<h3 class="text-xl font-semibold text-white">{ p.Name }</h3>
					<p class="text-sm text-gray-400">{ p.Size } &bull; { p.Notes }</p>
				</div>
				<div class="text-right shrink-0">
					<div class="font-semibold text-lg text-[var(--gold-soft)]">
						KES { formatPriceKes(p.PriceKes) }
					</div>
				</div>
			</div>
			<div class="mt-5 flex flex-col sm:flex-row gap-2">
				if p.Available {
					<button class="w-full sm:flex-1 py-2.5 rounded-2xl gold-btn text-sm" data-add={ p.ID }>
						Add to cart
					</button>
				} else {
					<button class="w-full sm:flex-1 py-2.5 rounded-2xl gold-btn text-sm" data-add={ p.ID } disabled>
						Currently unavailable
					</button>
				}
				<a
					class="w-full sm:w-auto py-2.5 px-4 rounded-2xl border border-white/20 text-sm text-gray-100 text-center hover:bg-white/10"
					href={ templ.SafeURL(whatsAppOrderURL(p)) }
					target="_blank"
					rel="noreferrer"
				>
					WhatsApp
				</a>
			</div>
		</div>
	</div>
}

templ ProductModal() {
	<div id="productModal" class="product-modal-overlay" role="dialog" aria-modal="true" style="display: none;">
		<div class="product-modal-panel">
			<button class="product-modal-close" id="modalClose" aria-label="Close">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
					<path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L10.94 12l-6.72 6.72a.75.75 0 1 0 1.06 1.06L12 13.06l6.72 6.72a.75.75 0 1 0 1.06-1.06L13.06 12l6.72-6.72a.75.75 0 0 0-1.06-1.06L12 10.94 5.28 4.22Z"></path>
				</svg>
			</button>
			<div class="product-modal-inner">
				<div class="product-modal-images">
					<div class="product-modal-main-img-wrap" id="modalImgWrap">
						<img id="modalMainImg" src="" alt="" class="product-modal-main-img"/>
						<div class="product-modal-img-placeholder"><span id="modalImgInitial"></span></div>
						<button class="modal-nav-btn modal-nav-prev" id="modalPrev" aria-label="Previous image">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M14.47 5.47a.75.75 0 0 1 0 1.06L8.81 12l5.66 5.47a.75.75 0 1 1-1.04 1.08l-6.25-6a.75.75 0 0 1 0-1.08l6.25-6a.75.75 0 0 1 1.04.02Z"></path></svg>
						</button>
						<button class="modal-nav-btn modal-nav-next" id="modalNext" aria-label="Next image">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M9.53 5.47a.75.75 0 0 0 0 1.06L15.19 12l-5.66 5.47a.75.75 0 1 0 1.04 1.08l6.25-6a.75.75 0 0 0 0-1.08l-6.25-6a.75.75 0 0 0-1.04.02Z"></path></svg>
						</button>
					</div>
					<div id="modalThumbs" class="product-modal-thumbs"></div>
				</div>
				<div class="product-modal-details">
					<div class="product-modal-badge" id="modalBadge"></div>
					<h2 class="product-modal-name" id="modalName"></h2>
					<div class="product-modal-price" id="modalPrice"></div>
					<div class="product-modal-meta" id="modalMeta"></div>
					<p class="product-modal-description" id="modalDescription"></p>
					<div class="product-modal-actions">
						<button id="modalAddToCart" class="gold-btn py-3 rounded-2xl font-medium text-sm w-full">Add to Cart</button>
						<a id="modalWhatsApp" href="#" target="_blank" rel="noreferrer" class="gold-outline-btn py-3 rounded-2xl text-sm font-semibold text-center w-full block">WhatsApp Order</a>
					</div>
				</div>
			</div>
		</div>
	</div>
}
